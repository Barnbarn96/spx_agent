# agent.py authenticates via `claude login` (your Claude subscription), not
# an API key. No ANTHROPIC_API_KEY here on purpose — see agent.py.
POLYGON_API_KEY=
FINNHUB_API_KEY=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# feed.py live source: "moomoo" (v2 default) or "polygon"
FEED_SOURCE=moomoo
# moomoo (Futu) OpenD gateway — only used if FEED_SOURCE=moomoo. Requires
# the Moomoo desktop app running + logged in, with OpenD running locally.
# Moomoo's OpenAPI doesn't support subscribing to US indices directly, so
# SPX is estimated from SPY scaled by a ratio. v2 calibrates it from the
# previous session's closes (plan.spx_prev_close / SPY prev close), falling
# back to the plan's spx_reference — RATIO below is just the initial guess.
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
MOOMOO_SPY_CODE=US.SPY
MOOMOO_SPY_SPX_RATIO=10.06
# main.py: how often (seconds) run_live() logs a tick-count/last-price
# heartbeat — lower it for closer-in testing, e.g. dry-run days.
HEARTBEAT_INTERVAL_S=60
DAILY_LOSS_LIMIT_USD=1000
MAX_OPEN_TRIGGERS=1
YIELD_WINDOW_MIN=5
YIELD_EPSILON=0.005
DECIDE_MODEL=claude-sonnet-5-5
PLAN_MODEL=claude-sonnet-5-5
# Thinking/tool-use depth: low|medium|high|xhigh|max, or blank for the
# model's own default. Kept separate per call site — see config.py.
DECIDE_EFFORT=
PLAN_EFFORT=

# v2 operator inputs (inputs.py)
# Minutes before a hand-entered 10Y yield counts as missing.
YIELD_MAX_AGE_MIN=20
# Minutes before GEX read off a screenshot is shown as stale.
GEX_MAX_AGE_MIN=90
# Warn when a GEX screenshot's SPX differs from the SPY estimate by more than this.
SPX_ESTIMATE_DRIFT_WARN_PTS=2
# Seconds between polls of state/ for plan, yield and GEX changes (replaces
# v1's PLAN_RELOAD_POLL_S).
INPUT_POLL_S=5
# v1's 08:00 ET automatic plan generation. Off in v2: /premarket writes the plan.
PLAN_AUTOGEN=false
