# agent.py authenticates via `claude login` (your Claude subscription), not
# an API key. No ANTHROPIC_API_KEY here on purpose — see agent.py.
POLYGON_API_KEY=
FINNHUB_API_KEY=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# feed.py live source: "polygon" (default) or "moomoo"
FEED_SOURCE=polygon
# moomoo (Futu) OpenD gateway — only used if FEED_SOURCE=moomoo. Requires
# the Moomoo desktop app running + logged in, with OpenD running locally.
# Moomoo's OpenAPI doesn't support subscribing to US indices directly, so
# SPX is estimated from SPY scaled by a ratio calibrated against each
# plan's spx_reference — RATIO below is just the initial guess.
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
MOOMOO_SPY_CODE=US.SPY
MOOMOO_SPY_SPX_RATIO=10.06
# main.py: how often (seconds) run_live() logs a tick-count/last-price
# heartbeat — lower it for closer-in testing, e.g. dry-run days.
HEARTBEAT_INTERVAL_S=60
# How often a running main.py checks whether `python -m agent replan` has
# rewritten today's plan file, and hot-swaps the engine onto it.
PLAN_RELOAD_POLL_S=15
DAILY_LOSS_LIMIT_USD=1000
MAX_OPEN_TRIGGERS=1
YIELD_WINDOW_MIN=5
YIELD_EPSILON=0.005
DECIDE_MODEL=claude-sonnet-4-6
PLAN_MODEL=claude-sonnet-4-6
# Thinking/tool-use depth: low|medium|high|xhigh|max, or blank for the
# model's own default. Kept separate per call site — see config.py.
DECIDE_EFFORT=
PLAN_EFFORT=
